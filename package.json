{
  "name": "fluxo-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "Downloader de vídeo e áudio com yt-dlp",
  "main": "src/main.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "electron .",
    "start:web": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/core.test.js",
    "test:integration": "node test/integration.js",
    "test:ui": "node test/ui.js",
    "test:web": "node --test test/server.test.js",
    "test:web-ui": "node test/web-ui.js",
    "test:cookies": "node --test test/cookies.test.js"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "playwright": "1.63.0"
  }
}
