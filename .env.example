# Cole estas variáveis na aba Environment do serviço no Dokploy.
# Troque a senha: mínimo de 12 caracteres. Não publique o .env.
APP_USERNAME=admin
APP_PASSWORD=
ALLOWED_HOSTS=youtube.com,youtu.be,vimeo.com
MAX_CONCURRENT_JOBS=2
MAX_DOWNLOAD_MB=2048
MAX_STORAGE_MB=10240
FILE_RETENTION_HOURS=1
JOB_TIMEOUT_MINUTES=60
YTDLP_VERSION=2026.8.19
# Opcional: caminho de um arquivo de cookies montado no contêiner (nunca o conteúdo).
YTDLP_COOKIES_FILE=
